{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ba-sociology-hub",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "StudyHubChat"
      },
      {
        "name": "TRAFFIC_ROOM",
        "class_name": "OwnerTraffic"
      },
      {
        "name": "STUDY_QUOTA",
        "class_name": "StudyHelperQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StudyHubChat"
      ]
    },
    {
      "tag": "v2-owner-traffic",
      "new_sqlite_classes": [
        "OwnerTraffic"
      ]
    },
    {
      "tag": "v3-study-helper-quota",
      "new_sqlite_classes": [
        "StudyHelperQuota"
      ]
    }
  ],
  "services": [
    {
      "binding": "RESULTS_API",
      "service": "ba-sociology-results"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}

